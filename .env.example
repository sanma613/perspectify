# Supabase — obtén estos valores en supabase.com → Settings → Database
DATABASE_URL="postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres"

# Supabase Auth
SUPABASE_URL="https://[ref].supabase.co"
SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."   # solo en el backend, nunca en el frontend

# Stripe
STRIPE_SECRET_KEY="sk_test_..."

# Encryption key for endpoint secrets (must be 64 hex chars / 32 bytes)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# URLs
API_URL="http://localhost:3001"
WEB_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
# Optional comma-separated origins for API CORS (useful for Vercel prod + preview domains)
CORS_ORIGINS="http://localhost:3000"
# Allow https://*.vercel.app origins automatically (set to false to disable)
ALLOW_VERCEL_PREVIEWS="true"

# Resend email alerts
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="Perspectify <alerts@yourdomain.com>"